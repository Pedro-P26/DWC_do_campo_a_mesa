{
  "name": "do-campo-a-mesa-api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST + Socket.io do projeto Do Campo à Mesa (DWC)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/seed/seed.js",
    "seed:testes": "node src/seed/testes.js",
    "seed:avaliacoes": "node src/seed/avaliacoes.js",
    "test": "node --test test/*.test.js",
    "docs:validate": "node scripts/validar-openapi.js",
    "test:browser:frontend": "node test/e2e/frontend.js --headless",
    "test:browser:carrinho-desktop": "node test/e2e/carrinho-desktop.js --headless",
    "test:browser": "node test/e2e/frontend.js --headless",
    "test:e2e": "node test/e2e/frontend.js --headless",
    "test:e2e:enunciado": "node test/e2e/frontend.js --headless --enunciado",
    "test:e2e:riscos": "node test/e2e/frontend.js --headless --riscos",
    "test:e2e:paginacao": "node test/e2e/frontend.js --headless --paginacao",
    "test:e2e:leilao-destaque": "node test/e2e/frontend.js --headless --leilao-destaque",
    "test:e2e:localizacao": "node test/e2e/frontend.js --headless --localizacao",
    "test:e2e:navegadores": "node test/e2e/navegadores.cjs",
    "test:e2e:admin": "node test/e2e/admin.cjs",
    "test:e2e:todos": "node test/e2e/todos.cjs",
    "test:browser:visible": "node test/e2e/frontend.js --keep-open",
    "test:browser:painel-produtor": "node test/e2e/frontend.js --headless --painel-produtor",
    "test:concorrencia": "node --test test/funcionalidades.test.js"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.24.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.8.0",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.0.0",
    "@playwright/test": "^1.64.0",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.7"
  }
}
